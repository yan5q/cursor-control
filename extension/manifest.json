{
  "manifest_version": 3,
  "name": "Cursor Control",
  "version": "0.1.0",
  "description": "Let Cursor read and operate browser tabs you arm.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "storage", "offscreen", "scripting", "webNavigation", "alarms", "debugger"],
  "host_permissions": [
    "ws://127.0.0.1/*",
    "ws://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cursor Control",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
